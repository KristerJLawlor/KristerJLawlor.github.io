---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';

const projects = (await getCollection('projects')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Projects" description="A collection of my development projects." />
		<style>
			main {
				width: 960px;
			}
			h1 {
				margin-bottom: 2rem;
			}
			ul {
				display: flex;
				flex-direction: column;
				gap: 2rem;
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.card {
				display: grid;
				grid-template-columns: 280px 1fr;
				gap: 1.5rem;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 12px;
				overflow: hidden;
				transition: box-shadow 0.2s ease;
			}
			.card:hover {
				box-shadow: var(--box-shadow);
			}
			.card img {
				width: 100%;
				height: 100%;
				object-fit: cover;
			}
			.card-placeholder {
				background: rgb(var(--gray-light));
				width: 100%;
				height: 100%;
				min-height: 160px;
			}
			.card-body {
				padding: 1.25rem 1.25rem 1.25rem 0;
				display: flex;
				flex-direction: column;
				gap: 0.5rem;
			}
			.card-title {
				margin: 0;
				font-size: 1.25rem;
			}
			.card-title a {
				color: rgb(var(--black));
				text-decoration: none;
			}
			.card-title a:hover {
				color: rgb(var(--accent));
			}
			.card-description {
				margin: 0;
				color: rgb(var(--gray));
				flex: 1;
			}
			.tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4rem;
			}
			.tag {
				background: rgb(var(--gray-light));
				border-radius: 4px;
				padding: 0.2rem 0.5rem;
				font-size: 0.8rem;
				color: rgb(var(--gray-dark));
			}
			.links {
				display: flex;
				gap: 0.75rem;
				margin-top: 0.25rem;
			}
			.links a {
				font-size: 0.875rem;
				color: rgb(var(--accent));
				text-decoration: none;
			}
			.links a:hover {
				text-decoration: underline;
			}
			@media (max-width: 720px) {
				.card {
					grid-template-columns: 1fr;
				}
				.card-body {
					padding: 1rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>Projects</h1>
			<ul>
				{
					projects.map((project) => (
						<li>
							<div class="card">
								{project.data.heroImage ? (
									<Image
										width={280}
										height={180}
										src={project.data.heroImage}
										alt={project.data.title}
									/>
								) : (
									<div class="card-placeholder" />
								)}
								<div class="card-body">
									<h2 class="card-title">
										<a href={`/projects/${project.id}/`}>{project.data.title}</a>
									</h2>
									<p class="card-description">{project.data.description}</p>
									{project.data.tags.length > 0 && (
										<div class="tags">
											{project.data.tags.map((tag) => (
												<span class="tag">{tag}</span>
											))}
										</div>
									)}
									<div class="links">
										<a href={`/projects/${project.id}/`}>Read more →</a>
										{project.data.url && <a href={project.data.url} target="_blank" rel="noopener">Live site ↗</a>}
										{project.data.githubUrl && <a href={project.data.githubUrl} target="_blank" rel="noopener">GitHub ↗</a>}
									</div>
								</div>
							</div>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>

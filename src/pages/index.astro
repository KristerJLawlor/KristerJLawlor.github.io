---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const recentPosts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

const recentProjects = (await getCollection('projects'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero {
				padding: 3rem 0 2rem;
				border-bottom: 1px solid rgb(var(--gray-light));
				margin-bottom: 2.5rem;
			}
			.hero h1 {
				margin: 0 0 0.5rem;
				font-size: 2.5rem;
			}
			.hero .tagline {
				font-size: 1.15rem;
				color: rgb(var(--accent));
				margin: 0 0 1rem;
				font-weight: 600;
			}
			.hero p {
				color: rgb(var(--gray-dark));
				max-width: 600px;
				line-height: 1.7;
				margin: 0 0 1.5rem;
			}
			.hero-links {
				display: flex;
				gap: 0.75rem;
				flex-wrap: wrap;
			}
			.btn {
				display: inline-block;
				padding: 0.5rem 1.25rem;
				border-radius: 6px;
				text-decoration: none;
				font-size: 0.9rem;
				font-weight: 600;
			}
			.btn-primary {
				background: rgb(var(--accent));
				color: white;
			}
			.btn-secondary {
				border: 1px solid rgb(var(--accent));
				color: rgb(var(--accent));
			}
			.btn:hover {
				opacity: 0.85;
			}
			section {
				margin-bottom: 3rem;
			}
			.section-header {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				margin-bottom: 1.25rem;
				border-bottom: 1px solid rgb(var(--gray-light));
				padding-bottom: 0.5rem;
			}
			.section-header h2 {
				margin: 0;
				font-size: 1.25rem;
			}
			.section-header a {
				font-size: 0.875rem;
				color: rgb(var(--accent));
				text-decoration: none;
			}
			.section-header a:hover {
				text-decoration: underline;
			}
			.post-list {
				list-style: none;
				margin: 0;
				padding: 0;
				display: flex;
				flex-direction: column;
				gap: 1rem;
			}
			.post-item a {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				gap: 1rem;
				text-decoration: none;
				color: rgb(var(--black));
				padding: 0.5rem 0;
			}
			.post-item a:hover .post-title {
				color: rgb(var(--accent));
			}
			.post-title {
				font-weight: 600;
				transition: color 0.2s;
			}
			.post-date {
				color: rgb(var(--gray));
				font-size: 0.875rem;
				white-space: nowrap;
			}
			.project-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
				gap: 1.25rem;
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.project-card {
				border: 1px solid rgb(var(--gray-light));
				border-radius: 10px;
				overflow: hidden;
				transition: box-shadow 0.2s ease;
				display: flex;
				flex-direction: column;
			}
			.project-card:hover {
				box-shadow: var(--box-shadow);
			}
			.project-card img {
				width: 100%;
				height: 140px;
				object-fit: cover;
			}
			.project-placeholder {
				background: rgb(var(--gray-light));
				height: 140px;
			}
			.project-card-body {
				padding: 1rem;
				display: flex;
				flex-direction: column;
				gap: 0.4rem;
				flex: 1;
			}
			.project-card-title {
				margin: 0;
				font-size: 1rem;
			}
			.project-card-title a {
				color: rgb(var(--black));
				text-decoration: none;
			}
			.project-card-title a:hover {
				color: rgb(var(--accent));
			}
			.project-card-desc {
				margin: 0;
				font-size: 0.875rem;
				color: rgb(var(--gray));
				flex: 1;
			}
			.tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.3rem;
				margin-top: 0.25rem;
			}
			.tag {
				background: rgb(var(--gray-light));
				border-radius: 4px;
				padding: 0.15rem 0.4rem;
				font-size: 0.75rem;
				color: rgb(var(--gray-dark));
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="hero">
				<h1>Krister Lawlor</h1>
				<p class="tagline">Software Developer</p>
				<p>
					Welcome to my corner of the web. I build things with code and write about what I'm
					learning along the way. Explore my projects or read the blog to see what I've been
					working on.
				</p>
				<div class="hero-links">
					<a href="/projects" class="btn btn-primary">View Projects</a>
					<a href="/blog" class="btn btn-secondary">Read Blog</a>
					<a href="https://github.com/KristerJLawlor" target="_blank" rel="noopener" class="btn btn-secondary">GitHub ↗</a>
				</div>
			</div>

			{recentProjects.length > 0 && (
				<section>
					<div class="section-header">
						<h2>Recent Projects</h2>
						<a href="/projects">All projects →</a>
					</div>
					<ul class="project-grid">
						{recentProjects.map((project) => (
							<li class="project-card">
								{project.data.heroImage ? (
									<Image width={400} height={140} src={project.data.heroImage} alt={project.data.title} />
								) : (
									<div class="project-placeholder" />
								)}
								<div class="project-card-body">
									<h3 class="project-card-title">
										<a href={`/projects/${project.id}/`}>{project.data.title}</a>
									</h3>
									<p class="project-card-desc">{project.data.description}</p>
									{project.data.tags.length > 0 && (
										<div class="tags">
											{project.data.tags.map((tag) => <span class="tag">{tag}</span>)}
										</div>
									)}
								</div>
							</li>
						))}
					</ul>
				</section>
			)}

			{recentPosts.length > 0 && (
				<section>
					<div class="section-header">
						<h2>Recent Posts</h2>
						<a href="/blog">All posts →</a>
					</div>
					<ul class="post-list">
						{recentPosts.map((post) => (
							<li class="post-item">
								<a href={`/blog/${post.id}/`}>
									<span class="post-title">{post.data.title}</span>
									<span class="post-date">
										<FormattedDate date={post.data.pubDate} />
									</span>
								</a>
							</li>
						))}
					</ul>
				</section>
			)}
		</main>
		<Footer />
	</body>
</html>
